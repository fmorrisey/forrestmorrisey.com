---
import { FEEDS } from "../lib/feeds";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <!-- Only entry point to /tags outside individual writing posts: the header
         nav is per-section, and the other collections don't render their tags. -->
    <!-- The rel=alternate autodiscovery tags in BaseLayout only reach visitors
         whose browser or reader surfaces them; most no longer do. These links
         are the only way someone can see the feeds exist. -->
    <p class="footer-links">
      <a href="/tags">Browse by tag</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href={FEEDS.writing.path}>Writing RSS</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href={FEEDS.adventures.path}>Adventures RSS</a>
    </p>
    <p class="copyright">© {year} Forrest Morrisey</p>
    <p class="signature">Built with intention. Designed for impact.</p>
    <!-- The site moved off Rainier to Cloudflare Pages (see infra/README.md), so
         "Self-Hosted on" was no longer true. Keeps the Rainier link, drops the
         claim. -->
    <p class="hosted">Built by hand at <a href="https://rainierserver.com/">Rainier Server</a> 🏔</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 48px 24px;
    text-align: center;
    border-top: 1px solid var(--border);
    margin-top: 64px;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-links {
    font-size: 0.85rem;
    margin: 0 0 12px;
  }

  .footer-links .sep {
    color: var(--muted);
    margin: 0 8px;
  }

  .copyright {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0 0 8px;
  }

  .signature {
    font-size: 0.75rem;
    font-style: italic;
    color: var(--muted);
    opacity: 0.7;
    margin: 0;
  }

  .hosted {
    font-size: 0.75rem;
    font-style: italic;
    color: var(--muted);
    opacity: 0.7;
    margin: 0;
  }
</style>
